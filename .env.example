# Prisma reads this exact variable name in prisma/schema.prisma (required for migrate, db push, app).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Some hosts (e.g. Vercel Postgres) only inject POSTGRES_URL. npm scripts map it to DATABASE_URL if unset.
# POSTGRES_URL="postgresql://..."

# Groq (Vercel AI SDK streaming assistant). Optional: without it, /api/ai/chat returns 503.
GROQ_API_KEY=""
